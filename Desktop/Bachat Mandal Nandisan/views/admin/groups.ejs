<%- include('../partials/head', { title: t('groups') }) %>
<div class="pagehead">
  <div>
    <h2><%= t('groups') %></h2>
    <p class="muted small"><%= groups.length %> <%= t('groups') %> · <%= members.length %> <%= t('members') %></p>
  </div>
  <div class="actions"><button type="button" class="btn" onclick="const d=document.getElementById('addfam');d.open=true;d.scrollIntoView({behavior:'smooth'});d.querySelector('input').focus()">+ <%= t('addGroup') %></button></div>
</div>
<details class="card panel" id="addfam"><summary><%= t('addGroup') %></summary>
  <form method="post" action="/admin/groups" class="stack three">
    <label><%= t('nameEn') %> (<%= t('head') %>)<input name="name" required></label>
    <label><%= t('nameGu') %><input name="nameGu"></label>
    <label><%= t('mobile') %><input name="mobile" inputmode="tel"></label>
    <div class="formactions"><button class="btn"><%= t('addGroup') %></button></div>
  </form>
</details>
<input class="search" placeholder="🔍 <%= t('typeToSearch') %>" data-cardsearch>
<div class="gridcards">
<% groups.forEach(g => { const ms = members.filter(m => String(m.group) === String(g._id)); const u = userByGroup[String(g._id)]; %>
  <div class="card gcard" id="g<%= g._id %>" data-s="<%= g.name %> <%= g.mobile || '' %> <%= ms.map(m => m.name + ' ' + m.srNo).join(' ') %>">
    <div class="cardhead">
      <div>
        <h3><%= lang === 'gu' && g.nameGu ? g.nameGu : g.name %></h3>
        <div class="meta"><% if (g.mobile) { %><a href="tel:<%= g.mobile %>">📞 <%= g.mobile %></a><% } else { %>—<% } %>
          <% if (g.upiId || g.upiQr) { %> · <span class="tag active" title="<%= g.upiId || 'QR' %>">UPI ✓</span><% } %><% if (u && u.username !== g.mobile) { %> · <span title="<%= t('loginOf') %>">🔑 <%= u.username %></span><% } %><% if (u && !u.active) { %> <span class="tag closed"><%= t('disabled') %></span><% } %><% if (!u) { %> <span class="tag no"><%= t('noLogin') %></span><% } %></div>
      </div>
      <span class="count"><%= ms.length %></span>
    </div>
    <table class="t small members">
      <% ms.forEach(m => { const isHead = String(g.head) === String(m._id); %>
      <tr class="<%= m.status !== 'active' ? 'dim' : '' %>">
        <td class="sr"><%= m.srNo %></td>
        <td><a href="/admin/members/<%= m._id %>"><%= mname(m) %></a><% if (isHead) { %> <span class="tag head"><%= t('head') %></span><% } %><% if (m.status !== 'active') { %> <span class="tag closed"><%= t(m.status) %></span><% } %></td>
        <td class="r act"><% if (!isHead && m.status === 'active') { %><form method="post" action="/admin/groups/<%= g._id %>/head" class="inline"><input type="hidden" name="member" value="<%= m._id %>"><button class="iconbtn" title="<%= t('makeHead') %>" aria-label="<%= t('makeHead') %>">★</button></form><% } %></td>
      </tr>
      <% }) %>
    </table>
    <details class="manage"><summary><%= t('manage') %></summary>
      <div class="managebody">
        <form method="post" action="/admin/groups/<%= g._id %>/members" class="mgroup">
          <b><%= t('addMember') %></b>
          <div class="formrow"><input name="name" placeholder="<%= t('nameEn') %>" required><input name="nameGu" placeholder="<%= t('nameGu') %>"><input name="mobile" placeholder="<%= t('mobile') %>" inputmode="tel"></div>
          <div class="formactions"><button class="btn sm"><%= t('addMember') %></button></div>
        </form>
        <form method="post" action="/admin/groups/<%= g._id %>/login" class="mgroup">
          <b><%= u ? t('resetPassword') : t('createLogin') %></b>
          <div class="formrow"><input name="username" value="<%= u ? u.username : (g.mobile || '') %>" placeholder="<%= t('username') %>" required><input name="password" placeholder="<%= t('newPassword') %>" minlength="6" required></div>
          <div class="formactions"><button class="btn sm"><%= u ? t('resetPassword') : t('createLogin') %></button></div>
        </form>
        <form method="post" action="/admin/groups/<%= g._id %>/upi" class="mgroup">
          <b>💳 <%= t('familyUpi') %></b>
          <div class="formrow"><input name="upiId" value="<%= g.upiId || '' %>" placeholder="name@okaxis" autocapitalize="off"><input name="upiName" value="<%= g.upiName || '' %>" placeholder="<%= t('upiName') %>"></div>
          <div class="formactions"><% if (g.upiQr) { %><span class="muted small grow">✓ QR</span><% } %><button class="btn sm"><%= t('save') %></button></div>
        </form>
        <form method="post" action="/admin/groups/<%= g._id %>" class="mgroup">
          <b><%= t('editFamily') %></b>
          <div class="formrow"><input name="name" value="<%= g.name %>" placeholder="<%= t('nameEn') %>"><input name="nameGu" value="<%= g.nameGu || '' %>" placeholder="<%= t('nameGu') %>"><input name="mobile" value="<%= g.mobile || '' %>" placeholder="<%= t('mobile') %>"><input name="order" type="number" value="<%= g.order %>" class="w-num" title="<%= t('srNo') %>"></div>
          <div class="formactions">
            <% if (!ms.length) { %><button class="btn sm danger" formaction="/admin/groups/<%= g._id %>/delete" onclick="return confirm('<%= t('confirmDelete') %>')"><%= t('delete') %></button><% } %>
            <button class="btn sm"><%= t('save') %></button>
          </div>
        </form>
      </div>
    </details>
  </div>
<% }) %>
</div>
<%- include('../partials/foot') %>
