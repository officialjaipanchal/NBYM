<%- include('../partials/head', { title: t('groups') }) %>
<h2 class="h"><%= t('groups') %> (<%= groups.length %>) · <%= t('members') %> (<%= members.length %>)</h2>
<details class="card"><summary><b>+ <%= t('addGroup') %></b></summary>
  <form method="post" action="/admin/groups" class="formrow">
    <input name="name" placeholder="<%= t('nameEn') %> (<%= t('head') %>)" required>
    <input name="nameGu" placeholder="<%= t('nameGu') %>">
    <input name="mobile" placeholder="<%= t('mobile') %>" inputmode="tel">
    <button class="btn"><%= t('add') %></button>
  </form>
</details>
<input class="search" placeholder="🔍 <%= t('search') %>" data-cardsearch>
<div class="gridcards">
<% groups.forEach(g => { const ms = members.filter(m => String(m.group) === String(g._id)); const u = userByGroup[String(g._id)]; %>
  <div class="card gcard" id="g<%= g._id %>" data-s="<%= g.name %> <%= ms.map(m => m.name + ' ' + m.srNo).join(' ') %>">
    <div class="row between">
      <h3><%= lang === 'gu' && g.nameGu ? g.nameGu : g.name %></h3>
      <span class="tag soft"><%= ms.length %> <%= t('membersCount') %></span>
    </div>
    <div class="muted small">📱 <%= g.mobile || '—' %> · <%= t('loginOf') %>: <% if (u) { %><b><%= u.username %></b> <span class="tag <%= u.active ? 'active' : 'closed' %>"><%= u.active ? t('enabled') : t('disabled') %></span><% } else { %><span class="tag no"><%= t('noLogin') %></span><% } %></div>
    <table class="t small">
      <% ms.forEach(m => { %>
      <tr class="<%= m.status !== 'active' ? 'dim' : '' %>">
        <td><%= m.srNo %></td>
        <td><a href="/admin/members/<%= m._id %>"><%= mname(m) %></a><% if (String(g.head) === String(m._id)) { %> <span class="tag head"><%= t('head') %></span><% } %><% if (m.status !== 'active') { %> <span class="tag closed"><%= t(m.status) %></span><% } %></td>
        <td class="r"><% if (String(g.head) !== String(m._id)) { %><form method="post" action="/admin/groups/<%= g._id %>/head" class="inline"><input type="hidden" name="member" value="<%= m._id %>"><button class="link small"><%= t('makeHead') %></button></form><% } %></td>
      </tr>
      <% }) %>
    </table>
    <details><summary class="small">+ <%= t('addMember') %></summary>
      <form method="post" action="/admin/groups/<%= g._id %>/members" class="formrow">
        <input name="name" placeholder="<%= t('nameEn') %>" required><input name="nameGu" placeholder="<%= t('nameGu') %>"><input name="mobile" placeholder="<%= t('mobile') %>"><button class="btn sm"><%= t('add') %></button>
      </form>
    </details>
    <details><summary class="small">🔑 <%= u ? t('resetPassword') : t('createLogin') %></summary>
      <form method="post" action="/admin/groups/<%= g._id %>/login" class="formrow">
        <input name="username" value="<%= u ? u.username : (g.mobile || '') %>" placeholder="<%= t('username') %>" required>
        <input name="password" placeholder="<%= t('newPassword') %>" minlength="6" required><button class="btn sm"><%= t('save') %></button>
      </form>
    </details>
    <details><summary class="small">✎ <%= t('edit') %></summary>
      <form method="post" action="/admin/groups/<%= g._id %>" class="formrow">
        <input name="name" value="<%= g.name %>"><input name="nameGu" value="<%= g.nameGu || '' %>"><input name="mobile" value="<%= g.mobile || '' %>"><input name="order" type="number" value="<%= g.order %>" style="max-width:5em" title="order"><button class="btn sm"><%= t('save') %></button>
      </form>
      <% if (!ms.length) { %><form method="post" action="/admin/groups/<%= g._id %>/delete" data-confirm="<%= t('confirmDelete') %>"><button class="btn sm danger"><%= t('delete') %></button></form><% } %>
    </details>
  </div>
<% }) %>
</div>
<%- include('../partials/foot') %>
