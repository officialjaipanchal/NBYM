<%- include('../partials/head', { title: t('settings') }) %>
<h2 class="h"><%= t('settings') %></h2>
<form method="post">
<div class="card">
  <h3><%= t('settingsMoney') %></h3>
  <div class="stack two">
    <label><%= t('shortName') %><input name="shortName" value="<%= settings.shortName || 'NBYM' %>" maxlength="20"></label>
    <label><%= t('name') %> (EN)<input name="mandalName" value="<%= settings.mandalName %>"></label>
    <label><%= t('name') %> (ગુજ)<input name="mandalNameGu" value="<%= settings.mandalNameGu %>"></label>
    <label><%= t('samajName') %> (EN)<input name="samajName" value="<%= settings.samajName %>"></label>
    <label><%= t('samajName') %> (ગુજ)<input name="samajNameGu" value="<%= settings.samajNameGu %>"></label>
    <label><%= t('monthlyAmount') %><input type="number" name="monthlyAmount" value="<%= settings.monthlyAmount %>"></label>
    <label><%= t('dueDay') %><input type="number" name="dueDay" min="1" max="28" value="<%= settings.dueDay %>"></label>
    <label><%= t('lateFeeRule') %><input type="number" step="0.01" name="lateFeePer100PerDay" value="<%= settings.lateFeePer100PerDay %>"></label>
    <label><%= t('maxLoan') %><input type="number" name="maxLoan" value="<%= settings.maxLoan %>"></label>
    <label><%= t('interestRate') %><input type="number" step="0.01" name="interestRate" value="<%= settings.interestRate %>"></label>
    <label><%= t('interestPeriod') %><select name="interestPeriod"><option value="monthly" <%= settings.interestPeriod === 'monthly' ? 'selected' : '' %>><%= t('perMonth') %></option><option value="yearly" <%= settings.interestPeriod === 'yearly' ? 'selected' : '' %>><%= t('perYear') %></option></select></label>
    <label><%= t('insuranceAmount') %><input type="number" name="insuranceAmount" value="<%= settings.insuranceAmount %>"></label>
  </div>
  <p class="muted small"><%= lang === 'gu' ? 'વ્યાજ દરનો ફેરફાર નવી લોન પર લાગુ થશે; જૂની લોન તેના દરે જ ચાલશે.' : 'Rate changes apply to new loans; existing loans keep their own rate.' %></p>
</div>
<div class="card">
  <h3><%= t('permissions') %></h3>
  <div class="checks">
  <% Object.keys(settings.perm.toObject ? settings.perm.toObject() : settings.perm).forEach(k => { %>
    <label class="chk"><input type="checkbox" name="perm_<%= k %>" <%= settings.perm[k] ? 'checked' : '' %>> <%= t('perm_' + k) %></label>
  <% }) %>
  </div>
  <div class="flash warn small">🔒 <%= t('permNote') %></div>
</div>
<button class="btn"><%= t('save') %></button>
</form>
<%- include('../partials/foot') %>
