<%- include('../partials/head', { title: t('loans') }) %>
<div class="pagehead">
  <div><h2>🔒 <%= t('loans') %></h2><p class="muted small"><%= t('loanPrivate') %></p></div>
  <div class="actions"><a class="btn" href="#new">+ <%= t('newLoan') %></a></div>
</div>
<div class="stats">
  <div class="stat big"><span><%= t('currentBalance') %></span><b><%= money(totals.cash) %></b></div>
  <div class="stat"><span><%= t('totalLent') %></span><b><%= money(totals.outstanding) %></b></div>
  <div class="stat"><span><%= t('interestAccrued') %></span><b><%= money(totals.interestAccrued) %></b></div>
  <div class="stat"><span><%= t('interestIn') %></span><b><%= money(totals.interestIn) %></b></div>
</div>
<%- include('loanqueue') %>
<div class="card">
<% if (!rows.length) { %><p class="muted"><%= t('noLoans') %></p><% } else { %>
<div class="scroll"><table class="t">
  <tr><th><%= t('borrower') %></th><th><%= t('loanDate') %></th><th><%= t('loanAmount') %></th><th><%= t('outstanding') %></th><th><%= t('interestDue') %></th><th><%= t('guarantors') %></th><th><%= t('status') %></th></tr>
  <% rows.forEach(({ l, st }) => { %>
  <tr class="<%= st.overdue ? 'badrow' : '' %> <%= l.status === 'closed' ? 'dim' : '' %>">
    <td><a href="/admin/loans/<%= l._id %>"><b><%= mname(l.borrower) %></b></a></td><td><%= dl(l.date) %></td><td><%= money(l.amount) %></td>
    <td><%= money(st.principal) %></td><td><%= money(st.interestDue) %></td><td class="small"><%= l.guarantors.map(mname).join(', ') %></td>
    <td><span class="tag <%= l.status %>"><%= t(l.status) %></span><% if (l.status === 'active' && !l.disbursedOn) { %> <span class="tag head" title="<%= t('notSentYet') %>">💸</span><% } %><% if (st.overdue) { %> <span class="tag no">⚠</span><% } %></td>
  </tr>
  <% }) %>
</table></div>
<% } %>
</div>
<div class="card" id="new">
  <h3>+ <%= t('newLoan') %></h3>
  <p class="muted small"><%= t('maxLoan') %>: <%= money(settings.maxLoan) %> · <%= t('rate') %>: <%= settings.interestRate %>% <%= t(settings.interestPeriod === 'monthly' ? 'perMonth' : 'perYear') %></p>
  <form method="post" action="/admin/loans" class="stack two">
    <label><%= t('borrower') %><select name="borrower" required><option value=""></option><% members.forEach(m => { %><option value="<%= m._id %>" data-s="<%= m.name %> <%= m.nameGu || '' %> <%= m.srNo %> <%= m.mobile || '' %>"><%= m.srNo %>. <%= mname(m) %></option><% }) %></select></label>
    <label><%= t('loanAmount') %><input name="amount" type="number" min="1" max="<%= settings.maxLoan %>" required></label>
    <label><%= t('guarantor') %> 1<select name="g1" required><option value=""></option><% members.forEach(m => { %><option value="<%= m._id %>" data-s="<%= m.name %> <%= m.nameGu || '' %> <%= m.srNo %> <%= m.mobile || '' %>" <%= busy.has(String(m._id)) ? 'disabled' : '' %>><%= m.srNo %>. <%= mname(m) %><%= busy.has(String(m._id)) ? ' (' + t('guarantor') + ')' : '' %></option><% }) %></select></label>
    <label><%= t('guarantor') %> 2<select name="g2" required><option value=""></option><% members.forEach(m => { %><option value="<%= m._id %>" data-s="<%= m.name %> <%= m.nameGu || '' %> <%= m.srNo %> <%= m.mobile || '' %>" <%= busy.has(String(m._id)) ? 'disabled' : '' %>><%= m.srNo %>. <%= mname(m) %><%= busy.has(String(m._id)) ? ' (' + t('guarantor') + ')' : '' %></option><% }) %></select></label>
    <label><%= t('loanDate') %><input name="date" type="date" value="<%= di(today) %>" required></label>
    <label><%= t('rate') %><span class="formrow tight"><input name="rate" type="number" step="0.01" value="<%= settings.interestRate %>" style="max-width:6em">%
      <select name="ratePeriod"><option value="monthly" <%= settings.interestPeriod === 'monthly' ? 'selected' : '' %>><%= t('perMonth') %></option><option value="yearly" <%= settings.interestPeriod === 'yearly' ? 'selected' : '' %>><%= t('perYear') %></option></select></span></label>
    <label class="full"><%= t('reason') %><input name="reason"></label>
    <div class="formactions"><button class="btn"><%= t('newLoan') %></button></div>
  </form>
</div>
<%- include('../partials/foot') %>
