<%- include('../partials/head', { title: t('yearEnd') }) %>
<div class="pagehead"><div><h2><%= t('yearSummary') %> · <%= year.label %></h2>
<p class="muted small"><% if (year.startDate) { %><%= t('bestaVarsh') %> <%= dl(year.startDate) %> · <% } %><%= ml(year.months[0]) %> – <%= ml(year.months[11]) %></p></div>
<div class="actions"><button type="button" class="btn ghost" data-share="#share-settlement" data-share-name="NBYM-year-end">📤 <%= t('shareImage') %></button><button type="button" class="btn ghost" onclick="window.print()">🖨 <%= t('print') %></button><% if (pastYears.length) { %><a class="btn" href="/admin/payouts"><%= t('payouts') %></a><% } %></div></div>
<%- include('partials-summary') %>
<div class="card dangerc">
  <h3><%= t('closeYear') %></h3>
  <% if (activeLoans) { %><div class="flash err"><%= t('activeLoansBlock') %> (<%= activeLoans %>)</div><% } %>
  <% if (today < new Date(year.months[year.months.length - 1] + '-01T00:00:00Z')) { %><div class="flash warn"><%= t('closeEarlyWarn', { m: ml(year.months[year.months.length - 1]) }) %></div><% } %>
  <form method="post" action="/admin/year/close" class="stack two" data-confirm="<%= t('closeYear') %>?">
    <label><%= t('newYearLabel') %><input name="label" value="<%= nextLabel %>"></label>
    <label><%= t('bestaVarsh') %><input name="startDate" type="date" value="<%= di(today) %>"></label>
    <label><%= t('newYearStart') %><input name="start" type="month" value="<%= nextStart %>"></label>
    <label><%= t('opening') %><input name="openingBalance" type="number" value="0"></label>
    <label class="chk full"><input type="checkbox" name="adjustFirstMonth" checked> <%= t('adjustFirstMonth', { m: ml(nextStart) }) %></label>
    <div class="formactions confirmrow">
      <label class="inl"><span><%= t('typeConfirm') %></span><input name="confirm" placeholder="CLOSE" autocomplete="off" class="w-confirm"></label>
      <button class="btn danger" <%= activeLoans ? 'disabled' : '' %>><%= t('closeYear') %></button>
    </div>
  </form>
</div>
<% if (pastYears.length) { %>
<div class="card"><h3><%= t('pastYears') %></h3><% pastYears.forEach(y => { %><p><a href="/admin/years/<%= y._id %>"><%= y.label %></a> · <%= dl(y.closedAt) %> · <a href="/admin/payouts?year=<%= y._id %>"><%= t('payouts') %></a></p><% }) %></div>
<div class="card" id="reopen">
  <h3>↺ <%= t('reopenYear') %>: <%= pastYears[0].label %></h3>
  <p class="muted small"><%= t('reopenHelp', { y: pastYears[0].label, c: year.label }) %></p>
  <form method="post" action="/admin/year/reopen" data-confirm="<%= t('reopenYear') %>?">
    <div class="formactions confirmrow">
      <label class="inl"><span><%= t('reopenType') %></span><input name="confirm" placeholder="REOPEN" autocomplete="off" class="w-confirm"></label>
      <button class="btn ghost"><%= t('reopenYear') %></button>
    </div>
  </form>
</div>
<% } %>
<%- include('../partials/share-settlement') %>
<%- include('../partials/foot') %>
