<%- include('partials/head', { title: t('pending') }) %>
<div class="pagehead"><div><h2><%= t('pendingNow') %></h2><p class="muted small"><%= t('year') %> <%= year.label %> · <%= t('dueBy', { d: settings.dueDay }) %></p></div>
<div class="actions"><% if (list.length) { %><button type="button" class="btn ghost" data-share="#share-pending" data-share-name="NBYM-pending">📤 <%= t('shareImage') %></button><% } %><% if (me.role === 'admin') { %><a class="btn" href="/admin/collections"><%= t('markPaid') %></a><% } %></div></div>
<% if (!list.length) { %><div class="card center"><%= t('nobodyPending') %></div><% } else { %>
<div class="card">
<div class="scroll"><table class="t">
  <tr><th>#</th><th><%= t('name') %></th><th><%= t('pendingMonths') %></th><th><%= t('pendingAmount') %></th><% if (showFines) { %><th><%= t('fineSoFar') %></th><% } %></tr>
  <% let ta = 0, tf = 0; list.forEach((p, i) => { ta += p.amount; tf += p.fine; %>
  <tr><td><%= p.member.srNo %></td>
    <td><%= mname(p.member) %><% if (me.role === 'admin') { %> <a class="small" href="/admin/members/<%= p.member._id %>">✎</a><% } %></td>
    <td><% p.months.forEach(x => { %><span class="tag <%= x.late ? 'no' : 'soft' %>"><%= ml(x.month, true) %></span> <% }) %></td>
    <td><b><%= money(p.amount) %></b></td>
    <% if (showFines) { %><td><%= money(p.fine) %></td><% } %></tr>
  <% }) %>
  <tr class="totrow"><td></td><td><%= t('total') %> (<%= list.length %>)</td><td></td><td><%= money(ta) %></td><% if (showFines) { %><td><%= money(tf) %></td><% } %></tr>
</table></div>
</div>
<% } %>
<% if (list.length) { %><%- include('partials/share-pending', { plist: list, showFines }) %><% } %>
<%- include('partials/foot') %>
