<!doctype html>
<html lang="<%= lang %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= typeof title !== 'undefined' ? title + ' · ' : '' %><%= settings.shortName || 'NBYM' %></title>
<meta name="theme-color" content="#1d2b4f">
<link rel="icon" href="/logo.svg" type="image/svg+xml">
<link rel="icon" href="/icons/favicon-32.png" sizes="32x32" type="image/png">
<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
<link rel="manifest" href="/manifest.webmanifest">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="NBYM">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Baloo+Bhai+2:wght@500;600;700;800&family=Hind+Vadodara:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/style.css">
</head>
<body>
<header class="top">
  <a class="brand<%= me ? '' : ' nologin' %>" href="/">
    <img class="mark" src="/logo.svg" alt="" width="42" height="42">
    <span class="bnames">
      <span class="bname"><%= settings.shortName || 'NBYM' %></span>
      <span class="bfull"><%= lang === 'gu' ? settings.mandalNameGu : settings.mandalName %></span>
    </span>
  </a>
  <div class="topact">
    <% if (me) { %><span class="who"><%= me.role === 'admin' ? t('admin') + ' · ' : '' %><%= me.displayName || me.username %></span><% } %>
    <a class="pill" href="/lang/<%= lang === 'gu' ? 'en' : 'gu' %>" title="Language"><%= t('lang') %></a>
    <% if (me) { %>
      <a class="pill ghost icon" href="/change-password" title="<%= t('changePassword') %>">🔑</a>
      <form method="post" action="/logout" class="inline"><button class="pill ghost"><%= t('logout') %></button></form>
    <% } %>
  </div>
</header>
<% if (me && !me.mustChangePassword) { %>
<nav class="nav">
  <% const L = (href, key) => `<a href="${href}" class="${(href === '/' ? path === '/' : (href === '/admin' ? path === '/admin' || path === '/admin/' : path.startsWith(href))) ? 'on' : ''}">${t(key)}</a>`; %>
  <% if (me.role === 'admin') { %>
    <%- L('/admin', 'dashboard') %><%- L('/admin/collections', 'collections') %><%- L('/admin/groups', 'groups') %>
    <%- L('/admin/loans', 'loans') %><%- L('/pending', 'pending') %><%- L('/sahay', 'sahay') %><%- L('/admin/ledger', 'ledger') %>
    <%- L('/admin/year', 'yearEnd') %><%- L('/admin/payouts', 'payouts') %><%- L('/admin/users', 'users') %><%- L('/admin/settings', 'settings') %>
    <%- L('/admin/notify', 'notify') %><%- L('/admin/audit', 'audit') %><%- L('/rules', 'rules') %>
  <% } else { %>
    <%- L('/', 'home') %>
    <% if (settings.perm.showPending) { %><%- L('/pending', 'pending') %><% } %>
    <% if (settings.perm.showAllMembers) { %><%- L('/members', 'allMembers') %><% } %>
    <%- L('/sahay', 'sahay') %>
    <% if (settings.perm.showRules) { %><%- L('/rules', 'rules') %><% } %>
  <% } %>
</nav>
<% } %>
<% if (me && admins && admins.length) { %>
<div class="adminbar">
  <span class="ab-label"><%= t('currentAdmin') %></span>
  <% admins.forEach(a => { const nm = a.member ? mname(a.member) : (a.displayName || a.username); const ph = a.member ? (a.member.mobile || (a.member.group && a.member.group.mobile)) : null; %>
    <% if (ph) { %><a class="ab-chip" href="tel:<%= ph %>" title="<%= t('callAdmin') %> <%= ph %>"><span class="ab-av"><%= nm.trim().charAt(0) %></span><span class="ab-nm"><%= nm %></span><span class="ab-ph">📞 <%= ph %></span></a>
    <% } else { %><span class="ab-chip"><span class="ab-av"><%= nm.trim().charAt(0) %></span><span class="ab-nm"><%= nm %></span></span><% } %>
  <% }) %>
</div>
<% } %>
<main class="wrap">
<% if (flash) { %><div class="flash <%= flash.type %>"><%= flash.text %></div><% } %>
